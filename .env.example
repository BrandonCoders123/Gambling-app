# Omit DATABASE_URL for durable single-process local PostgreSQL in .data/postgres.
# DATABASE_URL=postgresql://user:password@host:5432/statarena
PORT=3000
APP_URL=http://localhost:3000
# Google OAuth is used only for sign-in. Store the secret in your host's secret manager.
# In Google Cloud, authorize: ${APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Production requires NODE_ENV=production, HTTPS APP_URL, DATABASE_URL and SMTP_URL.
# SMTP_URL=smtps://user:password@mail.example.com:465
MAIL_FROM=StatArena <noreply@example.com>
# Optional public nflverse refresh schedule. No sports API key needed.
# SYNC_INTERVAL_MINUTES=60
# SYNC_SEASON=2024
